<Project Sdk="Microsoft.NET.Sdk">

  <!-- Точка входа. Именно из этого проекта собирается WorldBox.exe -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WorldBox.Desktop</RootNamespace>
    <AssemblyName>WorldBox</AssemblyName>
    <RollForward>Major</RollForward>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorldBox.Core\WorldBox.Core.csproj" />
    <ProjectReference Include="..\WorldBox.Render\WorldBox.Render.csproj" />
    <ProjectReference Include="..\WorldBox.UI\WorldBox.UI.csproj" />
  </ItemGroup>

  <!-- Данные баланса и строки едут рядом с exe в папке data -->
  <ItemGroup>
    <Content Include="..\..\data\**\*.json" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
